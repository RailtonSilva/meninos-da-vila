# Copie para .env (uso local com `vercel dev`) e configure as mesmas
# variáveis na Vercel: Project → Settings → Environment Variables.

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-SECRETA

# Mensalidade (R$)
MENSALIDADE_VALOR=40

# Resend (e-mails de cobrança). O domínio do remetente precisa estar verificado no Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Meninos da Vila FC <financeiro@seudominio.com.br>"
PIX_CHAVE=

# Sentry: um DSN para a API (Node) e um para o navegador (pode ser o mesmo projeto)
SENTRY_DSN=
SENTRY_DSN_FRONTEND=

# Protege o envio automático de lembretes (Vercel Cron). Gere com: openssl rand -hex 32
CRON_SECRET=
